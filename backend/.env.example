NODE_ENV=development

# Local dev: run a free Neon Postgres project and paste its connection string here too
# (see README hosting section) — SQLite is no longer used, even locally, to keep
# local and hosted behavior identical.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Same credentials, but the non-pooled hostname (no "-pooler") — required for migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Shared secret the external cron pinger must send as the "x-cron-secret" header
# when calling POST /api/cron/goal-check. Make up a long random string.
CRON_SECRET="change-me-too"

# Leave SMTP_HOST blank to log goal reminders to the console instead of emailing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Yunis Health <no-reply@yunis-health.local>"
